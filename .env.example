# =====================================================================
# FPLBud environment variables
# Fill in the values, never commit .env (it's in .gitignore).
# NEXT_PUBLIC_* values are exposed to the browser; everything else is server-only.
# =====================================================================

# ---------- App ----------
APP_ENV=development
# Public URL of the Next.js site (used for OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public URL of the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Supabase (Project Settings > API) ----------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key, safe for the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key, SERVER ONLY (FastAPI + ingestion job), never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret, used by FastAPI to verify user sessions (Project Settings > API > JWT)
SUPABASE_JWT_SECRET=
# Transaction-mode pooler (port 6543). Dashboard → Database → Connect → Transaction pooler.
# Example: postgresql://postgres.[ref]:[password]@aws-0-....pooler.supabase.com:6543/postgres
# Session / direct (5432) also works locally. The API caps itself with the pool sizes below.
DATABASE_URL=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=8

# ---------- Google OAuth (via Supabase Auth) ----------
# Create an OAuth client in Google Cloud Console (APIs & Services > Credentials),
# then paste these into Supabase > Authentication > Providers > Google.
# Authorised redirect URI in Google: https://<your-project-ref>.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- FPL API ----------
FPL_API_BASE_URL=https://fantasy.premierleague.com/api
# Be polite to the FPL API
FPL_REQUEST_TIMEOUT_SECONDS=15
FPL_MAX_REQUESTS_PER_SECOND=3

# ---------- Team agent ----------
# Shared secret protecting POST /internal/agent/drain (generate a long random string)
INTERNAL_API_SECRET=
# How often the API checks the queue for leftover jobs
AGENT_POLL_INTERVAL_SECONDS=5
# Jobs stuck longer than this are re-queued
AGENT_JOB_TIMEOUT_SECONDS=300
AGENT_MAX_ATTEMPTS=3
# Signed-in users active within this many days get automatic re-runs
AGENT_TRACKING_WINDOW_DAYS=30

# ---------- Optional: LLM explanations ----------
# Leave LLM_ENABLED=false to use the free built-in template writer
LLM_ENABLED=false
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=10
# Suggested XI uses this key and model (tool calls required). It does not follow LLM_ENABLED.
LLM_LINEUP_TIMEOUT_SECONDS=45
LLM_LINEUP_MAX_SEARCHES=4
LLM_DAILY_CALL_CAP=200

# ---------- Optional: error monitoring ----------
SENTRY_DSN=

# ---------- Rate limits ----------
# Per-IP limit for public (guest) endpoints
GUEST_RATE_LIMIT_PER_MINUTE=10
# Per-user limit for /me and /suggestions
USER_RATE_LIMIT_PER_MINUTE=30
# Manual or weight-change agent re-runs per user per hour
AGENT_RERUN_LIMIT_PER_HOUR=6
